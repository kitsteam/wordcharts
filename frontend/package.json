{
  "name": "frontend_new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "compile": "formatjs compile-folder ./lang ./compiled-lang",
    "dev": "vite",
    "extract": "formatjs extract 'src/**/*.{ts,tsx}' --out-file ./lang/lang.json",
    "build": "tsc -p tsconfig.prod.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint-fix": "eslint .",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "check-types": "tsc --noemit"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "phoenix": "1.8.9",
    "qr-code-styling": "1.9.2",
    "react": "^18.2.0",
    "react-bootstrap": "2.10.10",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "react-intl": "6.8.9",
    "react-responsive-pagination": "^2.14.0",
    "react-router-dom": "7.18.2",
    "react-wordcloud": "https://github.com/b310-digital/react-wordcloud.git#ce1ee11d15cb39693414847c2e83e8199258b788"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@formatjs/cli": "^6.16.14",
    "@formatjs/ts-transformer": "^3.14.2",
    "@stylistic/eslint-plugin": "^3.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/phoenix": "1.6.7",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-formatjs": "^4.13.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest-clipboard": "0.0.11",
    "jsdom": "24.1.3",
    "sass": "1.101.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
